# Copy to .env. Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# One token per person; the role decides what retrieval may read (customer < support < sre).
API_TOKENS={"change-me-customer-token-0000000000": {"name": "demo-customer", "role": "customer"}, "change-me-support-token-00000000000": {"name": "demo-agent", "role": "support"}, "change-me-sre-token-000000000000000": {"name": "demo-oncall", "role": "sre"}}
RATE_LIMIT_PER_MINUTE=20

# Embeddings: ollama (nomic-embed-text on the host) or hash (CI and smoke tests only: no meaning)
EMBED_PROVIDER=ollama
# Retrieval: vector measured best on the benchmark (see bench/results.json); keyword and hybrid also work
RETRIEVE_MODE=vector

# Answers: offline (no model, keyword rules), proxy (containers -> `ska-llm-proxy` on the host), claude-cli (host only)
LLM_MODE=offline
LLM_PROXY_TOKEN=change-me-proxy-token-at-least-24-chars
GRADE_MODEL=claude-haiku-5-5
ANSWER_MODEL=claude-sonnet-5-5

# Host ports
API_PORT=8080
DB_PORT=5434
